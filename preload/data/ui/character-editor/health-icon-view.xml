<?xml version="1.0" encoding="utf-8"?>
<!--
  The little face in the health bar.

  Its own file in the game's data, and its own window here, because none of it
  has anything to do with how the character is drawn on the stage.
-->
<collapsible-dialog id="healthIconDialog" title="Health icon" width="400" height="470">
    <scrollview width="100%" height="100%" contentWidth="100%" scrollMode="drag">
        <vbox width="100%">
            <section-header text="Icon" />
            <textfield id="iconIdField" width="350" height="56" />
            <label id="iconHint" width="350" text="The name of the icon's image. Blank means the character's own id." />

            <section-header text="Look" />
            <hbox width="100%">
                <label width="150" text="Scale" verticalAlign="center" />
                <number-stepper id="iconScaleStepper" width="160" height="56" step="0.1" min="0.1" max="10" />
            </hbox>
            <hbox width="100%">
                <label width="150" text="Bops" verticalAlign="center" />
                <checkbox id="iconBopCheck" />
            </hbox>
            <hbox width="100%">
                <label width="150" text="Flip X" verticalAlign="center" />
                <checkbox id="iconFlipXCheck" />
            </hbox>
            <hbox width="100%">
                <label width="150" text="Pixel art" verticalAlign="center" />
                <checkbox id="iconPixelCheck" />
            </hbox>

            <section-header text="Offset" />
            <hbox width="100%">
                <number-stepper id="iconOffsetXStepper" width="155" height="56" step="1" />
                <number-stepper id="iconOffsetYStepper" width="155" height="56" step="1" />
            </hbox>
        </vbox>
    </scrollview>
</collapsible-dialog>
