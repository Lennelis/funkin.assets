<?xml version="1.0" encoding="utf-8"?>
<!--
  The character file itself, minus the parts that have windows of their own.
-->
<collapsible-dialog id="characterDataDialog" title="Character data" width="400" height="470">
    <scrollview width="100%" height="100%" contentWidth="100%" scrollMode="inertial">
        <vbox width="100%">
            <section-header text="Name" />
            <textfield id="nameField" width="350" height="40" />

            <section-header text="Sprite sheet" />
            <label id="renderTypeLabel" width="350" text="" />
            <label id="assetPathLabel" width="350" text="" />

            <section-header text="Size and facing" />
            <hbox width="100%">
                <label width="150" text="Scale" verticalAlign="center" />
                <number-stepper id="scaleStepper" width="160" height="40" step="0.1" min="0.1" max="20" />
            </hbox>
            <hbox width="100%">
                <label width="150" text="Flip X" verticalAlign="center" />
                <checkbox id="flipXCheck" />
            </hbox>
            <hbox width="100%">
                <label width="150" text="Pixel art" verticalAlign="center" />
                <checkbox id="isPixelCheck" />
            </hbox>

            <section-header text="Timing" />
            <hbox width="100%">
                <label width="150" text="Sing time" verticalAlign="center" />
                <number-stepper id="singTimeStepper" width="160" height="40" step="0.5" min="0" max="60" />
            </hbox>
            <hbox width="100%">
                <label width="150" text="Dance every" verticalAlign="center" />
                <number-stepper id="danceEveryStepper" width="160" height="40" step="0.25" min="0" max="32" />
            </hbox>

            <section-header text="Global offset" />
            <hbox width="100%">
                <number-stepper id="offsetXStepper" width="155" height="40" step="5" />
                <number-stepper id="offsetYStepper" width="155" height="40" step="5" />
            </hbox>

            <section-header text="Camera offset" />
            <hbox width="100%">
                <number-stepper id="cameraXStepper" width="155" height="40" step="5" />
                <number-stepper id="cameraYStepper" width="155" height="40" step="5" />
            </hbox>

            <section-header text="Starting animation" />
            <textfield id="startingAnimationField" width="350" height="40" />
        </vbox>
    </scrollview>
</collapsible-dialog>
