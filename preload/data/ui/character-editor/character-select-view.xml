<?xml version="1.0" encoding="utf-8"?>
<!--
  Choosing which character to work on.

  A grid of faces rather than a list of ids, the way the chart editor picks a
  character, because a face is recognisable at a glance and `bf-holding-gf` is
  not. The tiles are built in code, since one per character in the registry is
  not something a layout can know in advance.
-->
<collapsible-dialog id="characterSelectDialog" title="Character" width="460" height="300">
    <vbox width="100%" height="100%">
        <scrollview id="characterGridScroll" width="100%" height="230" contentWidth="100%" scrollMode="inertial" />
        <label id="characterNameLabel" width="100%" text="(choose a character)" />
        <label id="characterSlotLabel" width="100%" text="" />
    </vbox>
</collapsible-dialog>
