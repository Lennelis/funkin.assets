<?xml version="1.0" encoding="utf-8"?>
<!--
  Making a character out of a sprite sheet.

  There is no file picker worth the name on a phone, so this does not ask for
  one: it reads a folder the app can already write to, which is the same
  folder it saves characters into, and lists whatever is sitting in there.
  Drop a Sparrow sheet — the .png and its .xml, named the same — into that
  folder from a file manager or a cable and it turns up in the list.

  Nothing here asks to be typed, either. The name comes from the file.

  Loading a sheet does not write anything: it builds the character in memory
  so the offsets and the rest of its data can be set first, and File > Export
  is what puts it anywhere.
-->
<collapsible-dialog id="newCharacterDialog" title="New character" width="450" height="470">
    <scrollview id="newCharacterScroll" width="100%" height="100%" contentWidth="100%" scrollMode="inertial">
        <vbox width="100%">
            <section-header text="Put a sprite sheet here" />
            <label id="sheetPathLabel" width="410" text="" />

            <section-header text="Sheet" />
            <hbox width="100%">
                <dropdown id="sheetDropdown" width="290" height="56" allowFocus="true">
                    <data />
                </dropdown>
                <button id="rescanButton" width="110" height="56" text="Rescan" />
            </hbox>
            <hbox width="100%">
                <button id="importButton" width="410" height="56" text="Import a sheet from this device" />
            </hbox>

            <section-header text="Animations found" />
            <label id="sheetSummaryLabel" width="410" text="" />

            <hbox width="100%">
                <button id="createButton" width="290" height="56" text="Load it in" />
                <button id="closeButton" width="110" height="56" text="Close" />
            </hbox>
            <label id="newCharacterStatus" width="410" text="" />
        </vbox>
    </scrollview>
</collapsible-dialog>
